{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD 编辑器",
  "version": "0.1.0",
  "identifier": "com.mdeditor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "",
  },
  "app": {
    "windows": [
      {
        "title": "MD 编辑器",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
